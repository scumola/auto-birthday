<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoBirthday" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/magenta</item>
        <item name="colorOnPrimary">@color/on_magenta</item>
        <item name="colorPrimaryContainer">@color/magenta_container</item>
        <item name="colorOnPrimaryContainer">@color/on_magenta_container</item>
        <item name="colorSecondary">@color/magenta</item>
        <item name="colorOnSecondary">@color/on_magenta</item>
        <item name="colorSecondaryContainer">@color/mauve_container</item>
        <item name="colorOnSecondaryContainer">@color/on_mauve_container</item>
        <item name="colorTertiary">@color/candle</item>
        <item name="colorOnTertiary">@color/on_candle</item>

        <item name="android:colorBackground">@color/plum_background</item>
        <item name="colorSurface">@color/plum_surface</item>
        <item name="colorSurfaceContainerLowest">@color/plum_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/plum_container_low</item>
        <item name="colorSurfaceContainer">@color/plum_container</item>
        <item name="colorSurfaceContainerHigh">@color/plum_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/plum_container_highest</item>
        <item name="colorSurfaceVariant">@color/plum_container_highest</item>
        <item name="colorOnSurface">@color/plum_on_surface</item>
        <item name="colorOnBackground">@color/plum_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/plum_on_surface_variant</item>
        <item name="colorOutline">@color/plum_outline</item>
        <item name="colorOutlineVariant">@color/plum_outline_variant</item>

        <!-- Content draws edge-to-edge; MainActivity pads for the system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>

    <!-- Display face: the app title, the next-up name, and the day number in date tiles -->
    <style name="TextAppearance.AutoBirthday.Display" parent="">
        <item name="android:fontFamily">@font/unbounded_semibold</item>
        <item name="fontFamily">@font/unbounded_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
